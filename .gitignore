# ---- Python ----
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# ---- 用户运行期产物（设置/日志/缓存放 %LOCALAPPDATA%，但这些可能出现在程序目录）----
userdata/
portable.flag

# ---- 数据目录：随包原件入库，用户工作区不入库 ----
03_下载数据/*/下载/*
!03_下载数据/*/下载/.gitkeep
03_下载数据/*/工作示例/
03_下载数据/SHERLOC/练习数据/
03_下载数据/SHERLOC/E2E测试数据/
# 缓存目录默认忽略，仅保留随包分发的运行缓存原件
03_下载数据/*/缓存/*
!03_下载数据/APXS/缓存/
!03_下载数据/ChemCam/缓存/ccam_default_wave.tab
!03_下载数据/ChemCam/缓存/edr_labels/
!03_下载数据/SuperCam/缓存/supercam_moc.csv
# 用户在数据目录里生成的导出/报告/标注
03_下载数据/**/_notes/
03_下载数据/**/_qc/
03_下载数据/**/_pixl_exports/

